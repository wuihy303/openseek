PORT=3000
HOST=0.0.0.0
# Optional: server-side GitHub token for higher GitHub API limits.
# Public repository metadata is all this application needs.
GITHUB_TOKEN=
SEARCH_RATE_LIMIT=20
CACHE_TTL_SECONDS=300
GITHUB_TIMEOUT_MS=10000
WEB_SEARCH_TIMEOUT_MS=10000
# Set this to 1 when your environment requires the inherited HTTP(S)_PROXY.
# NODE_USE_ENV_PROXY=1
